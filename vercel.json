{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rules-reminder",
      "schedule": "0 13 1 */3 *"
    },
    {
      "path": "/api/cron/timeclock-report",
      "schedule": "0 1 * * 0"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 2 * * *"
    }
  ]
}