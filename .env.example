# ─────────────────────────────────────────────────────────────────────────
# T. Maxwell Smith, PLLC — environment variables
# Copy to .env.local for local dev. The site renders WITHOUT these (it falls
# back to seed content); set them to enable the database, admin, email, etc.
# ─────────────────────────────────────────────────────────────────────────

# Public site URL (used for metadata, OG, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database (Vercel Postgres / Neon) ----
# Postgres connection string. When unset, the site uses built-in seed content.
DATABASE_URL=

# ---- Admin auth ----
# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=
# Initial admin, created by `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Media storage (Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Verified sending identity, e.g. "T. Maxwell Smith, PLLC <intake@texaslawsmith.com>"
RESEND_FROM=
# Where intake notifications go (defaults to firm email).
INTAKE_NOTIFY_EMAIL=

# ---- Scheduled publishing (Vercel Cron) ----
# Shared secret the cron route checks. Generate: openssl rand -base64 32
CRON_SECRET=

# ---- Spam protection (optional) ----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA4_ID=

# ---- Patriot Series 250 live broadcast (optional) ----
# Video runs on a home MediaMTX server fronted by Cloudflare Tunnel (see
# ./media-server); control runs on the Cloudflare Worker in ./control-worker.
# The live page falls back to a placeholder when these are unset.
#
# From your media server's tunnel hostname (see media-server/README.md).
# WHEP = browser playback (viewers); WHIP = the operator's publish.
PATRIOT_WHEP_URL=
PATRIOT_WHIP_URL=
# Control worker WebSocket URL (printed by `npm run deploy` in ./control-worker),
# e.g. wss://patriot-control-hub.<account>.workers.dev
PATRIOT_WS_URL=
# Shared secret for minting/verifying operator+switcher tokens. Generate:
# openssl rand -base64 32 — set the SAME value here and on the worker via
# `wrangler secret put CONTROL_SECRET`.
CONTROL_SECRET=
